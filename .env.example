# Copy to .env before `docker compose up`. Every value here is a default
# compose.yaml already applies.

# The moving tag: CI re-points it when Anthropic publishes a newer claude-desktop
# .deb or a newer Claude Code CLI. Pin a version tag instead
# (ghcr.io/prv-ctech/claude-code-linux:2.26454.2) to freeze the desktop version.
CLAUDE_IMAGE=ghcr.io/prv-ctech/claude-code-linux:latest
CLAUDE_NAME=claude-code-linux

# The ids that own your host folders, and the mask for new files. Unraid is
# 99/100; most other Linux hosts are 1000/1000.
CLAUDE_PUID=99
CLAUDE_PGID=100
CLAUDE_UMASK=002

# 3000 is HTTP for the reverse proxy, 3001 is HTTPS (self-signed) for the LAN.
# Never expose either to the Internet: there is no desktop login.
CLAUDE_HTTP_PORT=3000
CLAUDE_HTTPS_PORT=3001

# Persistent state, mounted at /config. On Unraid this is
# /mnt/user/appdata/claude-code-linux, matching the template's AppData path.
CLAUDE_STATE=./appdata

# Docker's default /dev/shm is 64 MB and Chrome crashes on it.
CLAUDE_SHM_SIZE=2gb

CLAUDE_TZ=Etc/UTC

# Host folder with your projects, mounted at /workspaces.
CLAUDE_WORKSPACE=./workspace
