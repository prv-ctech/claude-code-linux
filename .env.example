# Copy to .env before `docker compose up`. Every value here is a default the
# image or compose already applies; the only one you must change is
# CLAUDE_PASSWORD.

# The moving tag: CI re-points it when Anthropic publishes a newer claude-desktop
# .deb or a newer Claude Code CLI. Pin a version tag instead
# (ghcr.io/prv-ctech/claude-code-linux:2.26454.2) to freeze the desktop version.
CLAUDE_IMAGE=ghcr.io/prv-ctech/claude-code-linux:latest
CLAUDE_NAME=claude-code-linux

# Required: login for the streamed desktop (user name is ubuntu). There is no
# permissive default, and compose refuses to start without this value.
CLAUDE_PASSWORD=change-me

# Supported values are 1000 and 1000, exclusively. The Selkies desktop layer is
# rootless at uid 1000 and the image exits 78 for anything else.
# Namespaced so a host that exports PUID/PGID (as Unraid does for its own
# containers) cannot silently change the container's session uid.
CLAUDE_PUID=1000
CLAUDE_PGID=1000

# Host port mapped to the container's only port, 8080/tcp. Never expose it to the
# Internet: the session holds your claude.ai and Claude Code credentials and the
# in-container TLS certificate is self-signed.
CLAUDE_PORT=8080

# Persistent state, mounted at /home/ubuntu (Chrome profile, keyring, Claude
# Desktop config, ~/.claude/.credentials.json). On Unraid this is
# /mnt/user/appdata/claude-code-linux, matching the template's appdata Path.
CLAUDE_STATE=./claude-code-state

# Docker's default /dev/shm is 64 MB and the browsers in this desktop crash on
# it. 2gb is the minimum that has been observed to work.
CLAUDE_SHM_SIZE=2gb

CLAUDE_TZ=Etc/UTC

# websocket (default) needs no extra ports. webRTC would additionally require
# TURN ports 3478/tcp+udp and 65532-65535, which compose.yaml does not publish.
SELKIES_MODE=websocket
