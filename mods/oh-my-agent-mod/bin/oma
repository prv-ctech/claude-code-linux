#!/usr/bin/env node
// oh-my-agent-mod helper, on the Bash PATH of every session while the plugin is enabled.
// Agents call it as plain one-line commands, which worktree-isolated subagents are allowed to run
// (Claude Code refuses shell loops, runtime variables and long && chains inside a worktree).
//
//   oma cfg                         the profile's json block (.oma/project.md), as JSON
//   oma run <install|lint|build|test>   runs that profile command here; prints "<what> exit <code>" last
//   oma serve <port>                starts the profile's start command on <port>, detached, logs to
//                                   .oma/job/dev-<port>.log, waits up to 120 s for `oma up`
//   oma up <port> [seconds]         waits (default 0 s) until http://localhost:<port><upPath> answers 200
//   oma port <port>                 pids listening on <port> ("busy (pid unknown)" for another user's
//                                   process); nothing printed when free
//   oma stop <port>                 stops what listens on <port>, only if `oma serve` started it in this
//                                   repository (this folder or another of its worktrees), unless --force
//   oma status init <ticket-folder|repro:<slug>> <port>
//   oma status <step> [note] [--evals p/f/t] [--round next|<n>]
//                                   writes .oma/job/status.json at the
//                                   git top level, keeping `stepStarted` right and `updated` current
//   oma merge <branch> [specs/tickets/NNN-slug] [--worktree <path>]
//                                   main checkout only: merges <branch> into the branch checked out here
//                                   (--no-ff), runs install (when a manifest changed), lint, build and test on
//                                   the result, undoes the merge if one fails, marks the ticket done. Last line:
//                                   MERGED | CONFLICT | FAILED ...; exit 0 only for MERGED
//   oma log-fix <one line>          adds a done row to specs/tickets/BOARD.md for a fix that had no ticket
//   oma stress <up|down>            up: a detached worktree of this checkout's HEAD under .claude/worktrees/oma-stress,
//                                   installed and served on port 3080 for the blind visitors; prints SKIPPED: <why>
//                                   when the app is not a web app or its data is shared. down: stops and removes it
//   oma now                         ISO UTC time
//
// Exit codes: 0 ok, 1 failed (message on stderr), 2 bad usage.
'use strict';
const fs = require('fs');
const path = require('path');
const { spawnSync, spawn } = require('child_process');

const STEPS = ['setup', 'building', 'testing', 'reviewing', 'fixing', 'done', 'blocked'];
const now = () => new Date().toISOString().replace(/\.\d{3}Z$/, 'Z');
const die = (msg, code = 1) => {
  process.stderr.write(`oma: ${msg}\n`);
  process.exit(code);
};

function top(dir = process.cwd()) {
  const r = spawnSync('git', ['rev-parse', '--show-toplevel'], { cwd: dir, encoding: 'utf8' });
  return r.status === 0 ? r.stdout.trim() : dir;
}
const jobDir = root => path.join(root, '.oma', 'job');

// The first ```json block of .oma/project.md, with `<port>` left in place.
function cfg(root = top()) {
  const file = path.join(root, '.oma', 'project.md');
  let text;
  try {
    text = fs.readFileSync(file, 'utf8');
  } catch {
    die(`${file} not found; run /oma in the main checkout first`);
  }
  const m = text.match(/```json[^\n]*\n([\s\S]*?)\n```/);
  if (!m) die(`${file} has no json block`);
  try {
    return JSON.parse(m[1]);
  } catch (e) {
    die(`${file} json block is not valid JSON (${e.message})`);
  }
}
const isNone = v => v === undefined || v === null || /^\s*(none|)\s*$/i.test(String(v));
const withPort = (s, port) => String(s).replace(/<port>/g, String(port));

// { busy, pids }. ss shows pids only for this user's processes, so a listener with none is still busy.
function probe(port) {
  const r = spawnSync('ss', ['-Hltnp', `sport = :${port}`], { encoding: 'utf8' });
  if (r.status !== 0) return { busy: false, pids: [] };
  const lines = r.stdout.split('\n').filter(l => l.trim());
  return { busy: lines.length > 0, pids: [...new Set([...r.stdout.matchAll(/pid=(\d+)/g)].map(m => Number(m[1])))] };
}
const listening = port => probe(port).pids;
const busy = port => probe(port).busy;

function upCode(port, upPath) {
  const url = `http://localhost:${port}${upPath && upPath.startsWith('/') ? upPath : `/${upPath || ''}`}`;
  const r = spawnSync('curl', ['-s', '-o', '/dev/null', '-m', '10', '-w', '%{http_code}', url], { encoding: 'utf8' });
  return { url, code: (r.stdout || '').trim() || '000' };
}

const sleep = ms => Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms);

function waitUp(port, seconds, upPath) {
  const end = Date.now() + seconds * 1000;
  for (;;) {
    const u = upCode(port, upPath);
    if (u.code === '200') return u;
    if (Date.now() >= end) return u;
    sleep(2000);
  }
}

function cmdUp([port, seconds = '0']) {
  if (!/^\d+$/.test(port || '')) die('usage: oma up <port> [seconds]', 2);
  const c = cfg();
  if (isNone(c.start)) die('the profile has no start command (start: none)');
  const u = waitUp(port, Number(seconds) || 0, c.upPath);
  console.log(`${u.url} ${u.code}`);
  process.exit(u.code === '200' ? 0 : 1);
}

function cmdServe([port]) {
  if (!/^\d+$/.test(port || '')) die('usage: oma serve <port>', 2);
  const root = top();
  const c = cfg(root);
  if (isNone(c.start)) die('the profile has no start command (start: none)');
  const held = probe(port);
  if (held.busy) {
    const u = upCode(port, c.upPath);
    die(`port ${port} is already in use by ${held.pids.length ? `pid ${held.pids.join(',')}` : 'a process of another user'} (${u.url} ${u.code}); not starting another server`);
  }
  fs.mkdirSync(jobDir(root), { recursive: true });
  const log = path.join(jobDir(root), `dev-${port}.log`);
  const out = fs.openSync(log, 'a');
  const child = spawn('bash', ['-c', withPort(c.start, port)], {
    cwd: root, detached: true, stdio: ['ignore', out, out], env: { ...process.env, PORT: String(port) },
  });
  child.unref();
  fs.writeFileSync(path.join(jobDir(root), `dev-${port}.pid`), `${child.pid}\n`);
  const u = waitUp(port, 120, c.upPath);
  if (u.code !== '200') die(`app did not come up: ${u.url} ${u.code}; see ${log}`);
  try {
    process.kill(-child.pid, 0); // our server is the one answering, not something that grabbed the port
  } catch {
    die(`the start command exited, yet ${u.url} answers: another process holds port ${port}; see ${log}`);
  }
  console.log(`serving ${u.url} (pid ${child.pid}, log ${log})`);
}

function cmdPort([port]) {
  if (!/^\d+$/.test(port || '')) die('usage: oma port <port>', 2);
  const held = probe(port);
  if (held.pids.length) console.log(held.pids.join('\n'));
  else if (held.busy) console.log('busy (pid unknown: another user\'s process)');
}

// The pid file `oma serve <port>` left in this folder, or else in another worktree of this repository
// (a stopped or re-routed agent's), with the folder it is in.
function findPidFile(root, port) {
  const name = path.join('.oma', 'job', `dev-${port}.pid`);
  const wt = spawnSync('git', ['worktree', 'list', '--porcelain'], { cwd: root, encoding: 'utf8' });
  const dirs = wt.status === 0 ? wt.stdout.split('\n').filter(l => l.startsWith('worktree ')).map(l => l.slice(9)) : [];
  for (const d of [root, ...dirs.filter(d => path.resolve(d) !== path.resolve(root))]) {
    const f = path.join(d, name);
    try {
      const pid = Number(fs.readFileSync(f, 'utf8').trim());
      if (pid) return { file: f, pid, dir: d };
    } catch {
      /* none here */
    }
  }
  return null;
}

function cmdStop(args) {
  const port = args[0];
  if (!/^\d+$/.test(port || '')) die('usage: oma stop <port> [--force]', 2);
  const root = top();
  const found = findPidFile(root, port);
  const pidFile = found && found.file;
  const group = found ? found.pid : null;
  const held = probe(port);
  const pids = held.pids;
  if (!held.busy && !group) return console.log(`port ${port} free`);
  if (!group && !args.includes('--force')) die(`port ${port} is held by ${pids.length ? `pid ${pids.join(',')}` : 'a process of another user'}, not started by oma serve in this repository; left running`);
  if (found && found.dir !== root) console.log(`stopping the server oma serve started in ${found.dir}`);
  // The server was started detached, so its pid is its process group: kill the whole group.
  if (group) {
    try {
      process.kill(-group, 'SIGTERM');
    } catch {
      /* already gone */
    }
  }
  for (const pid of pids) {
    try {
      process.kill(pid, 'SIGTERM');
    } catch {
      /* already gone */
    }
  }
  for (let i = 0; i < 20 && busy(port); i++) sleep(500);
  for (const pid of listening(port)) {
    try {
      process.kill(pid, 'SIGKILL');
    } catch {
      /* gone */
    }
  }
  if (pidFile) fs.rmSync(pidFile, { force: true });
  if (busy(port)) die(`port ${port} still held${listening(port).length ? ` by pid ${listening(port).join(',')}` : ''}`);
  console.log(`port ${port} free`);
}

function cmdRun([what]) {
  if (!['install', 'lint', 'build', 'test'].includes(what)) die('usage: oma run <install|lint|build|test>', 2);
  const root = top();
  const c = cfg(root);
  if (isNone(c[what])) return console.log(`${what} none (skipped)`);
  const r = spawnSync('bash', ['-c', c[what]], { cwd: process.cwd(), stdio: 'inherit' });
  const code = r.status === null ? 1 : r.status;
  console.log(`${what} exit ${code}: ${c[what]}`);
  process.exit(code);
}

function flags(args) {
  const out = { rest: [] };
  for (let i = 0; i < args.length; i++) {
    const a = args[i];
    if (a === '--evals' || a === '--round') out[a.slice(2)] = args[++i];
    else out.rest.push(a);
  }
  return out;
}

const statusFile = root => path.join(jobDir(root), 'status.json');

function writeStatus(file, s) {
  fs.mkdirSync(path.dirname(file), { recursive: true });
  const tmp = `${file}.${process.pid}.tmp`;
  fs.writeFileSync(tmp, JSON.stringify(s) + '\n');
  fs.renameSync(tmp, file);
}

function cmdStatus(args) {
  const f = flags(args);
  const root = top();
  const file = statusFile(root);
  const t = now();
  if (f.rest[0] === 'init') {
    const [, target, port] = f.rest;
    if (!target || !/^\d+$/.test(port || '')) die('usage: oma status init <ticket-folder|repro:<slug>> <port>', 2);
    let ticket;
    let slug;
    if (target.startsWith('repro:')) {
      ticket = 'repro';
      slug = target.slice(6) || 'bug';
    } else {
      slug = path.basename(target.replace(/\/+$/, ''));
      const m = slug.match(/^(\d{3})-/);
      if (!m) die(`ticket folder must be specs/tickets/NNN-slug, got ${target}`, 2);
      ticket = m[1];
    }
    const b = spawnSync('git', ['branch', '--show-current'], { cwd: root, encoding: 'utf8' });
    const s = { ticket, slug, step: 'setup', stepStarted: t, updated: t, port: Number(port), branch: (b.stdout || '').trim(),
      evals: { passed: 0, failed: 0, total: 0, round: 0 }, note: 'setting up' };
    writeStatus(file, s);
    return console.log(JSON.stringify(s));
  }
  const [step, ...noteParts] = f.rest;
  if (!STEPS.includes(step)) die(`usage: oma status <${STEPS.join('|')}> [note] [--evals p/f/t] [--round next|<n>]`, 2);
  let s;
  try {
    s = JSON.parse(fs.readFileSync(file, 'utf8'));
  } catch {
    die(`${file} missing or not JSON; run oma status init first`);
  }
  if (s.step !== step) s.stepStarted = t;
  s.step = step;
  s.updated = t;
  if (noteParts.length) s.note = noteParts.join(' ');
  s.evals = s.evals || { passed: 0, failed: 0, total: 0, round: 0 };
  if (f.evals) {
    const m = f.evals.match(/^(\d+)\/(\d+)\/(\d+)$/);
    if (!m || Number(m[1]) + Number(m[2]) !== Number(m[3])) die('--evals is passed/failed/total, and passed + failed must equal total', 2);
    Object.assign(s.evals, { passed: Number(m[1]), failed: Number(m[2]), total: Number(m[3]) });
  }
  if (f.round) s.evals.round = f.round === 'next' ? (Number(s.evals.round) || 0) + 1 : Number(f.round) || 0;
  // A blocked worker is let through the finish gate on its note, so it must be this call's own note.
  if (step === 'blocked' && !noteParts.join(' ').trim()) die('a blocked status needs a note saying why: oma status blocked "<why>"', 2);
  writeStatus(file, s);
  console.log(JSON.stringify(s));
}

// --- oma merge / oma log-fix ------------------------------------------------------------------------
// Merging, as one command the router runs in the main checkout. Its last line
// is the result (MERGED | CONFLICT | FAILED ...); exit 0 only for MERGED. It never resolves a conflict
// and never pushes: a conflict or a failing branch goes back to the worker.

const gitIn = (cwd, args) => spawnSync('git', args, { cwd, encoding: 'utf8' });
const MANIFESTS = /(^|\/)(package\.json|package-lock\.json|pnpm-lock\.yaml|yarn\.lock|bun\.lockb?|pyproject\.toml|poetry\.lock|uv\.lock|requirements[^/]*\.txt|Cargo\.(toml|lock)|go\.(mod|sum)|Gemfile(\.lock)?|composer\.(json|lock))$/;

// Runs one profile command in `root`. { skipped } when the profile says none, else { code }.
function runIn(root, what) {
  const c = cfg(root)[what];
  if (isNone(c)) return { skipped: true, code: 0 };
  const r = spawnSync('bash', ['-c', c], { cwd: root, stdio: ['ignore', 2, 2] });
  return { code: r.status === null ? 1 : r.status };
}

const boardFile = root => path.join(root, 'specs', 'tickets', 'BOARD.md');
const BOARD_HEAD = '| # | Title | Status | Mode | Runs |\n|---|---|---|---|---|\n';
function boardRows(root) {
  let text = '';
  try {
    text = fs.readFileSync(boardFile(root), 'utf8');
  } catch {
    /* no board yet */
  }
  const rows = [];
  for (const line of text.split('\n')) {
    const c = line.split('|').map(x => x.trim());
    if (c.length > 5 && /^\d+$/.test(c[1])) rows.push({ id: c[1].padStart(3, '0'), status: c[3], runs: c[5], line });
  }
  return { text, rows };
}

// A fix that had no ticket gets a done row, so the board lists everything that landed. Returns its number.
function logFix(root, title, how) {
  const { text, rows } = boardRows(root);
  let max = rows.reduce((m, r) => Math.max(m, Number(r.id)), 0);
  try {
    for (const n of fs.readdirSync(path.dirname(boardFile(root)))) if (/^\d{3}-/.test(n)) max = Math.max(max, Number(n.slice(0, 3)));
  } catch {
    /* no tickets folder yet */
  }
  const id = String(max + 1).padStart(3, '0');
  fs.mkdirSync(path.dirname(boardFile(root)), { recursive: true });
  const clean = String(title).replace(/[|\r\n]+/g, ' ').trim();
  fs.writeFileSync(boardFile(root), `${text || BOARD_HEAD}${text && !text.endsWith('\n') ? '\n' : ''}| ${id} | Fix: ${clean} | done | solo | ${how} |\n`);
  return id;
}

function cmdLogFix(args) {
  const title = args.join(' ').trim();
  if (!title) die('usage: oma log-fix <one line saying what was fixed>', 2);
  console.log(`logged as ${logFix(top(), title, 'quick fix')} on specs/tickets/BOARD.md`);
}

async function cmdMerge(args) {
  let worktree = '';
  const rest = [];
  for (let i = 0; i < args.length; i++) {
    if (args[i] === '--worktree') worktree = args[++i] || '';
    else rest.push(args[i]);
  }
  const [branch, ticketArg] = rest;
  if (!branch) die('usage: oma merge <branch> [specs/tickets/NNN-slug] [--worktree <path>]', 2);
  const root = top();
  const slug = ticketArg ? path.basename(ticketArg.replace(/\/+$/, '')) : '';
  const label = slug || `fix (${branch})`;
  const end = (line, code = 1) => {
    console.log(line);
    process.exit(code);
  };
  const g = a => gitIn(root, a);
  const head = () => g(['rev-parse', 'HEAD']).stdout.trim();
  const short = sha => sha.slice(0, 7);

  // 1. Is this checkout ready?
  const base = g(['branch', '--show-current']).stdout.trim();
  if (!base) end(`FAILED ${label}: not on a branch: check out the base branch in ${root} first`);
  if (g(['rev-parse', '-q', '--verify', 'MERGE_HEAD']).status === 0) end(`FAILED ${label}: a merge is already in progress in ${root}`);
  const dirty = spawnSync(process.execPath, [path.join(__dirname, '..', 'scripts', 'oma.mjs'), 'dirty', '--dir', root], { encoding: 'utf8' });
  if (dirty.status === 1) end(`FAILED ${label}: dirty tree: ${dirty.stdout.trim().split('\n').join(', ')}`);
  if (dirty.status !== 0) end(`FAILED ${label}: could not check the tree: ${dirty.stderr.trim()}`);
  if (g(['rev-parse', '-q', '--verify', `${branch}^{commit}`]).status !== 0) end(`FAILED ${label}: branch ${branch} does not exist`);
  if (!g(['log', '--oneline', `${base}..${branch}`]).stdout.trim()) end(`FAILED ${label}: nothing to merge: ${branch} has no commits beyond ${base}`);

  // 2. The ticket must still be what the person approved, here and in the worker's own copy.
  if (slug) {
    const { problem } = await import(require('url').pathToFileURL(path.join(__dirname, '..', 'scripts', 'approve.mjs')).href);
    const why = problem(root, slug) || (worktree && problem(root, slug, worktree));
    if (why) end(`FAILED ${label}: not approved: ${why}${worktree && !problem(root, slug) ? ` (in the worker's copy under ${worktree})` : ''}`);
  }

  // 3. A build that can't run next to a dev server: say so before touching anything.
  const c = cfg(root);
  let profile = '';
  try {
    profile = fs.readFileSync(path.join(root, '.oma', 'project.md'), 'utf8');
  } catch {
    /* cfg() already required it */
  }
  if (!isNone(c.build) && /can run together in one folder:\*\*\s*no\b/i.test(profile) && c.mainPort && probe(c.mainPort).busy) {
    end(`FAILED ${label}: dev server on ${c.mainPort} blocks the build`);
  }

  // 4. Merge. A conflict is never resolved here.
  const pre = head();
  const m = g(['merge', '--no-ff', '--no-edit', '-m', `Merge ${label}${slug ? ` (${branch})` : ''}`, branch]);
  if (m.status !== 0) {
    const files = g(['diff', '--name-only', '--diff-filter=U']).stdout.trim().split('\n').filter(Boolean);
    g(['merge', '--abort']);
    if (head() !== pre) end(`FAILED ${label}: merge failed and could not be aborted cleanly: ${m.stderr.trim().split('\n')[0]}`);
    end(files.length ? `CONFLICT ${label}: ${files.join(', ')} (${base} unchanged at ${short(pre)})` : `FAILED ${label}: merge refused: ${(m.stderr || m.stdout).trim().split('\n')[0]}`);
  }
  const merged = head();

  // 5. Install when a manifest changed, then lint, build and the full test suite on the merged result.
  const undo = why => {
    if (head() !== merged) end(`FAILED ${label}: ${why}, and ${base} moved meanwhile: merge left in place at ${short(merged)}`);
    const r = g(['reset', '--keep', pre]);
    if (r.status !== 0 || head() !== pre) end(`FAILED ${label}: ${why}, and main has local edits, merge left in place at ${short(merged)}: ${r.stderr.trim().split('\n')[0]}`);
  };
  const said = [];
  const changed = g(['diff', '--name-only', pre, merged]).stdout.split('\n');
  const steps = [...(changed.some(f => MANIFESTS.test(f)) ? ['install'] : []), 'lint', 'build', 'test'];
  for (const what of steps) {
    let r = runIn(root, what);
    // A test that fails once and passes on a second run is flaky, not this branch's fault.
    if (what === 'test' && r.code !== 0) {
      r = runIn(root, what);
      if (r.code === 0) said.push('test flaky (failed once, passed on rerun)');
    }
    if (r.code !== 0) {
      undo(`${what} failed`);
      // Did the tests already fail before this branch? Then it is not the worker's to fix.
      if (what === 'test' && runIn(root, 'test').code !== 0) end(`FAILED ${label}: base tests failing: the test command also fails on ${base} without this branch (${base} reset to ${short(pre)})`);
      end(`FAILED ${label}: ${what}: exit ${r.code}, output above (${base} reset to ${short(pre)})`);
    }
    if (!said.some(s => s.startsWith(what))) said.push(r.skipped ? `${what} none (skipped)` : `${what} ok`);
  }

  // 6. Mark it done (local files, never committed) and say what can start now.
  let done = 'no ticket';
  if (slug) {
    const id = slug.slice(0, 3);
    const rd = path.join(root, 'specs', 'tickets', slug, 'rd.md');
    const missing = [];
    try {
      fs.writeFileSync(rd, fs.readFileSync(rd, 'utf8').replace(/^\*\*Status:\*\*.*$/m, '**Status:** done'));
    } catch {
      missing.push('rd.md');
    }
    const { text, rows } = boardRows(root);
    const row = rows.find(r => r.id === id);
    if (row) {
      const cells = row.line.split('|');
      cells[3] = ' done ';
      fs.writeFileSync(boardFile(root), text.replace(row.line, cells.join('|')));
    } else missing.push('its BOARD.md row');
    const waiting = rows.filter(r => new RegExp(`waits for[^|]*\\b${id}\\b`, 'i').test(r.runs) && !/^done$/i.test(r.status)).map(r => r.id);
    done = `marked done${missing.length ? ` (missing: ${missing.join(', ')})` : ''}${waiting.length ? `; waited for ${id}: ${waiting.join(', ')}` : ''}`;
  } else {
    const title = g(['log', '-1', '--format=%s', branch]).stdout.trim() || branch;
    done = `logged as ${logFix(root, title, 'fix')}`;
  }
  end(`MERGED ${label}: merge ${short(merged)}, ${said.join(', ')}, ${done}`, 0);
}

// --- oma stress ------------------------------------------------------------------------------------
// The stress stage's own copy of the app: a detached worktree of the base branch on its own port, so
// blind visitors (one of them trying to break things) never touch the person's checkout or data.
const STRESS_PORT = 3080;
function cmdStress([what]) {
  const root = top();
  const dir = path.join(root, '.claude', 'worktrees', 'oma-stress');
  const self = [path.join(__dirname, 'oma')];
  if (what === 'down') {
    if (fs.existsSync(dir)) {
      spawnSync(process.execPath, [...self, 'stop', String(STRESS_PORT)], { cwd: dir, stdio: 'inherit' });
      const r = gitIn(root, ['worktree', 'remove', '--force', dir]);
      if (r.status !== 0) die(`could not remove ${dir}: ${r.stderr.trim()}`);
    }
    return console.log('stress app down');
  }
  if (what !== 'up') die('usage: oma stress <up|down>', 2);
  let profile = '';
  try {
    profile = fs.readFileSync(path.join(root, '.oma', 'project.md'), 'utf8');
  } catch {
    die('.oma/project.md not found; run /oma in the main checkout first');
  }
  const c = cfg(root);
  if (c.appType && c.appType !== 'web') return console.log(`SKIPPED: the stress stage is for web apps (appType: ${c.appType})`);
  if (isNone(c.start)) return console.log('SKIPPED: the profile has no start command');
  // A copy that shares one database with the person's app would let a visitor change their data.
  if (/Local data is per folder:\*\*\s*no\b/i.test(profile)) return console.log('SKIPPED: local data is not per folder (every copy shares one database), so a stress run would touch your data');
  if (fs.existsSync(dir)) die(`${dir} already exists: run "oma stress down" first`);
  const add = gitIn(root, ['worktree', 'add', '--detach', dir, 'HEAD']);
  if (add.status !== 0) die(`could not create the stress worktree: ${add.stderr.trim()}`);
  // Ignored files the app needs (what .worktreeinclude lists): plain paths only, no patterns.
  let include = '';
  try {
    include = fs.readFileSync(path.join(root, '.worktreeinclude'), 'utf8');
  } catch {
    /* none */
  }
  for (const line of include.split('\n').map(l => l.trim().replace(/^\/|\/$/g, ''))) {
    if (!line || line.startsWith('#') || /[*?[\]!]/.test(line) || line.includes('..')) continue;
    const from = path.join(root, line);
    if (fs.existsSync(from) && !fs.existsSync(path.join(dir, line))) fs.cpSync(from, path.join(dir, line), { recursive: true });
  }
  for (const step of [['run', 'install'], ['serve', String(STRESS_PORT)]]) {
    const r = spawnSync(process.execPath, [...self, ...step], { cwd: dir, stdio: ['ignore', 2, 2] });
    if (r.status !== 0) die(`stress app did not start (oma ${step.join(' ')} failed in ${dir}); run "oma stress down" to clean up`);
  }
  console.log(`stress app up: http://localhost:${STRESS_PORT} (worktree ${dir})`);
}

const [cmd, ...rest] = process.argv.slice(2);
const table = { cfg: () => console.log(JSON.stringify(cfg(), null, 2)), run: cmdRun, serve: cmdServe, up: cmdUp,
  port: cmdPort, stop: cmdStop, status: cmdStatus, merge: cmdMerge, 'log-fix': cmdLogFix, stress: cmdStress, now: () => console.log(now()) };
if (!table[cmd]) die('usage: oma <cfg|run|serve|up|port|stop|status|merge|log-fix|stress|now> ... (see the header of this file)', 2);
Promise.resolve(table[cmd](rest)).catch(e => die(e.message));
