#!/bin/sh
# Register codebase-memory-mcp with Claude Code for the session user.
#
# WHY THIS RUNS AT SESSION START (docs/DESIGN.md D10)
#   The binary is part of the image and moves with a rebuild. The registration is not:
#   Claude Code keeps user-scope servers in ~/.claude.json, and /home/ubuntu is the state
#   mount, so a recreated container with an empty mount has no entry. This script writes
#   the entry when it is missing. The command is the bare name, resolved on PATH at every
#   launch, so the entry never has to change when the image does.
#
# Run as uid 1000 from the desktop session (30-claude-code-linux-codebase-memory.desktop).
# It is idempotent and safe to run by hand.
set -eu

# The daemon socket lives in CBM_RUNTIME_DIR. The image sets it; this is the same path,
# for a session that did not inherit the image environment.
CBM_RUNTIME_DIR="${CBM_RUNTIME_DIR:-/run/codebase-memory-mcp}"
export CBM_RUNTIME_DIR

# The HTTP graph UI is not used by the agent and its port is not published by the image.
codebase-memory-mcp config set ui_enabled false > /dev/null 2>&1 ||
	echo "claude-codebase-memory-setup: could not turn the graph UI off (continuing)" >&2

if ! claude mcp get codebase-memory-mcp > /dev/null 2>&1; then
	claude mcp add --scope user codebase-memory-mcp \
		--env "CBM_RUNTIME_DIR=${CBM_RUNTIME_DIR}" \
		-- codebase-memory-mcp
	echo "claude-codebase-memory-setup: registered codebase-memory-mcp (user scope)"
fi
